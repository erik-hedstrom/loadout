{
  "name": "@erik-hedstrom/loadout",
  "version": "0.1.0",
  "description": "Add the skills that fit each prompt in Claude Code and Codex, or pick skills, MCP servers and a model tier per session with the launcher, from a separate library, using a cheap model (Jev).",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erik-hedstrom/loadout.git"
  },
  "homepage": "https://github.com/erik-hedstrom/loadout#readme",
  "bugs": "https://github.com/erik-hedstrom/loadout/issues",
  "bin": {
    "loadout": "dist/cli.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "smol-toml": "^1.9.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.0"
  }
}
